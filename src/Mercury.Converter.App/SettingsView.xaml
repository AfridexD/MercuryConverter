<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Mercury.Converter.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mercury.Converter.App">

    <Grid Background="{StaticResource McBg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,16,32,32" RowSpacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Back and title -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="BackButton" Style="{StaticResource McSubtleButton}" Click="Back_Click" Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Esc)">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <TextBlock Text="Settings" Style="{StaticResource McPageTitle}" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="360" />
                        <ColumnDefinition Width="2*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Converting from File Explorer" Style="{StaticResource McSectionLabel}" Margin="0,8,0,4" />

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE962;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Show in the right-click menu" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Adds To MP4, To WebP and more. On Windows 11, choose Show more options first." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RightClickSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="RightClick_Toggled"
                                              AutomationProperties.Name="Show in the right-click menu" MinWidth="0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A7;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="When converting from the menu" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="The small window shows progress, then a Show in folder button." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <ComboBox x:Name="QuickWindowBox" Grid.Column="2" Style="{StaticResource McComboBox}" DisplayMemberPath="Label"
                                          SelectionChanged="QuickWindow_SelectionChanged" AutomationProperties.Name="When converting from the menu" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Files" Style="{StaticResource McSectionLabel}" Margin="0,14,0,4" />

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Save converted files" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Used when nothing else is chosen in the window." Style="{StaticResource McCaptionText}" />
                                    <TextBlock x:Name="FolderText" Style="{StaticResource McCaptionText}" Foreground="{StaticResource McText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="UseOriginalButton" Content="Next to the originals" Style="{StaticResource McCompactButton}" Click="UseOriginal_Click" />
                                    <Button Content="Choose folder" Style="{StaticResource McCompactButton}" Click="ChooseFolder_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA18;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="If the name is already taken" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="A number is added, for example photo (2).webp. Existing files are never replaced." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource McSectionLabel}" Margin="0,14,0,4" />

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Previews" Style="{StaticResource McBodyText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="PreviewBox" Grid.Column="2" Style="{StaticResource McComboBox}" DisplayMemberPath="Label"
                                          SelectionChanged="Preview_SelectionChanged" AutomationProperties.Name="Previews" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Animations" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Follows the Windows animation effects setting." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource McCompactButton}" Click="AnimationSettings_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Open Windows settings" />
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="Performance" Style="{StaticResource McSectionLabel}" Margin="0,14,0,4" />

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEC4A;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Speed" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Balanced leaves room for other apps." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <ComboBox x:Name="SpeedBox" Grid.Column="2" Style="{StaticResource McComboBox}" DisplayMemberPath="Label"
                                          SelectionChanged="Speed_SelectionChanged" AutomationProperties.Name="Speed" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Encode video on the graphics card" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Uses less processor, but files are larger." Style="{StaticResource McCaptionText}" />
                                    <TextBlock x:Name="GpuText" Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="GpuSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="Gpu_Toggled"
                                              AutomationProperties.Name="Encode video on the graphics card" MinWidth="0" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7C4;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Show progress on the taskbar" Style="{StaticResource McBodyText}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="TaskbarSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="Taskbar_Toggled"
                                              AutomationProperties.Name="Show progress on the taskbar" MinWidth="0" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Updates" Style="{StaticResource McSectionLabel}" Margin="0,14,0,4" />

                        <Border Style="{StaticResource McSettingCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Tell me when a new version is out" Style="{StaticResource McBodyText}" />
                                    <TextBlock Text="Once a day Mercury asks GitHub if there is a newer version. Nothing else is sent, and nothing is installed without you." Style="{StaticResource McCaptionText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="UpdateSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="Update_Toggled"
                                              AutomationProperties.Name="Tell me when a new version is out" MinWidth="0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="About" Style="{StaticResource McSectionLabel}" Margin="0,8,0,0" />

                        <Border Style="{StaticResource McSettingCard}">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Image Source="ms-appx:///Assets/AppIcon64.png" Width="48" Height="48" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mercury Converter" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                    <TextBlock Text="Version 1.0.0 · Free and open source (MIT) · Collects no usage data" Style="{StaticResource McCaptionText}" MaxWidth="260" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource McCompactButton}" Click="SourceCode_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE943;" FontSize="14" />
                                    <TextBlock Text="Source code" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource McCompactButton}" Click="ReportProblem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEBE8;" FontSize="14" />
                                    <TextBlock Text="Report a problem" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource McCompactButton}" Click="License_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="License" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Style="{StaticResource McSettingCard}" Padding="0">
                            <StackPanel>
                                <Grid ColumnSpacing="14" Padding="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8F1;" FontSize="20" Foreground="{StaticResource McText2}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Third-party licenses" Style="{StaticResource McBodyText}" />
                                        <TextBlock Text="Mercury Converter runs these programs to do the converting. Each keeps its own license." Style="{StaticResource McCaptionText}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="LicenseList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:LicenseEntry">
                                            <Grid Padding="54,8,16,8" ColumnSpacing="8" BorderBrush="{StaticResource McStroke}" BorderThickness="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource McBodyText}" />
                                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource McCaptionText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="View license" Style="{StaticResource McCompactButton}" Tag="{x:Bind Url}" Click="ViewLicense_Click"
                                                        AutomationProperties.Name="{x:Bind ViewName}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="FFmpeg is GPL v3. The source for the exact build is linked from each license page." Style="{StaticResource McCaptionText}"
                                           Padding="54,12,16,14" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
