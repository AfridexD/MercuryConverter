<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mercury.Converter.App.QuickWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource McLayer}" Width="360" VerticalAlignment="Top">
        <StackPanel>
            <!-- Title bar: 32 px. The close button comes from Windows. -->
            <Grid x:Name="AppTitleBar" Height="32" Padding="12,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon32.png" Width="16" Height="16" />
                    <TextBlock Text="Quick Convert" FontSize="12" Foreground="{StaticResource McText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- The file -->
            <Grid Padding="16,8,16,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" Background="{StaticResource McCard}" BorderBrush="{StaticResource McStroke}" BorderThickness="1">
                    <FontIcon x:Name="KindIcon" FontSize="22" Foreground="{StaticResource McText2}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource McText}" />
                    <TextBlock x:Name="FileMeta" Style="{StaticResource McCaptionText}" />
                </StackPanel>
            </Grid>

            <!-- 1. Pick a format -->
            <StackPanel x:Name="PickPanel" Visibility="Collapsed">
                <StackPanel x:Name="FormatList" Spacing="2" Padding="8,0,8,8">
                    <TextBlock Text="Convert to" Style="{StaticResource McSectionLabel}" Margin="8,4,0,4" />
                </StackPanel>
                <Grid Padding="16,12,16,16" ColumnSpacing="8" Background="{StaticResource McBg}" BorderBrush="{StaticResource McStroke}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Convert" Style="{StaticResource McPrimaryButton}" HorizontalAlignment="Stretch" Click="Convert_Click" />
                    <Button Grid.Column="1" Content="More options…" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="OpenInMercury_Click" />
                </Grid>
            </StackPanel>

            <!-- 2. Converting -->
            <StackPanel x:Name="RunPanel" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="16,4,16,16">
                    <Grid>
                        <TextBlock x:Name="RunLabel" FontSize="13" Foreground="{StaticResource McText}" />
                        <TextBlock x:Name="RunPercent" FontSize="13" Foreground="{StaticResource McText2}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="RunBar" Height="4" Minimum="0" Maximum="100" Foreground="{StaticResource McAccent}" Background="{StaticResource McTrack}"
                                 AutomationProperties.Name="Converting" />
                </StackPanel>
                <Grid Padding="16,12,16,16" Background="{StaticResource McBg}" BorderBrush="{StaticResource McStroke}" BorderThickness="0,1,0,0">
                    <Button Content="Cancel" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="Cancel_Click" />
                </Grid>
            </StackPanel>

            <!-- 3 and 4. Done or problem -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <Border x:Name="ResultBox" Margin="16,4,16,16" Padding="12,10" CornerRadius="4">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="ResultIcon" FontSize="20" VerticalAlignment="Top" />
                        <TextBlock x:Name="ResultText" Grid.Column="1" FontSize="13" TextWrapping="WrapWholeWords" Foreground="{StaticResource McText}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Grid Padding="16,12,16,16" ColumnSpacing="8" Background="{StaticResource McBg}" BorderBrush="{StaticResource McStroke}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ResultPrimary" Style="{StaticResource McPrimaryButton}" HorizontalAlignment="Stretch" Click="ResultPrimary_Click" />
                    <Button x:Name="ResultSecondary" Grid.Column="1" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="ResultSecondary_Click" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
