<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens, light theme. Values come from the design handoff (docs/design/HANDOFF.md).
    The dark values are in ThemePalette.cs and are applied in code, so every window changes at once.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="McBgColor">#F2F3F6</Color>
    <Color x:Key="McWinStrokeColor">#1F000000</Color>
    <Color x:Key="McLayerColor">#FAFAFB</Color>
    <Color x:Key="McCardColor">#FFFFFF</Color>
    <Color x:Key="McCardHoverColor">#F6F7F9</Color>
    <Color x:Key="McStrokeColor">#14000000</Color>
    <Color x:Key="McStrokeStrongColor">#29000000</Color>
    <Color x:Key="McTextColor">#1A1B20</Color>
    <Color x:Key="McText2Color">#464953</Color>
    <Color x:Key="McText3Color">#5E626D</Color>
    <Color x:Key="McCtrlColor">#FFFFFF</Color>
    <Color x:Key="McCtrlHoverColor">#F6F7F9</Color>
    <Color x:Key="McCtrlStrokeColor">#1F000000</Color>
    <Color x:Key="McSubtleHoverColor">#0D000000</Color>
    <Color x:Key="McInputColor">#FFFFFF</Color>
    <Color x:Key="McAccentColor">#1F4FD6</Color>
    <Color x:Key="McAccentHoverColor">#1A43B8</Color>
    <Color x:Key="McOnAccentColor">#FFFFFF</Color>
    <Color x:Key="McAccentSoftColor">#141F4FD6</Color>
    <Color x:Key="McDisabledFillColor">#14000000</Color>
    <Color x:Key="McDisabledTextColor">#66000000</Color>
    <Color x:Key="McTrackColor">#1F000000</Color>
    <Color x:Key="McOkColor">#0F7B0F</Color>
    <Color x:Key="McErrColor">#C42B1C</Color>
    <Color x:Key="McOkSoftColor">#DFF6DD</Color>
    <Color x:Key="McErrSoftColor">#FDE7E9</Color>
    <Color x:Key="McFlyoutColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="McBg" Color="{StaticResource McBgColor}" />
    <SolidColorBrush x:Key="McWinStroke" Color="{StaticResource McWinStrokeColor}" />
    <SolidColorBrush x:Key="McLayer" Color="{StaticResource McLayerColor}" />
    <SolidColorBrush x:Key="McCard" Color="{StaticResource McCardColor}" />
    <SolidColorBrush x:Key="McCardHover" Color="{StaticResource McCardHoverColor}" />
    <SolidColorBrush x:Key="McStroke" Color="{StaticResource McStrokeColor}" />
    <SolidColorBrush x:Key="McStrokeStrong" Color="{StaticResource McStrokeStrongColor}" />
    <SolidColorBrush x:Key="McText" Color="{StaticResource McTextColor}" />
    <SolidColorBrush x:Key="McText2" Color="{StaticResource McText2Color}" />
    <SolidColorBrush x:Key="McText3" Color="{StaticResource McText3Color}" />
    <SolidColorBrush x:Key="McCtrl" Color="{StaticResource McCtrlColor}" />
    <SolidColorBrush x:Key="McCtrlHover" Color="{StaticResource McCtrlHoverColor}" />
    <SolidColorBrush x:Key="McCtrlStroke" Color="{StaticResource McCtrlStrokeColor}" />
    <SolidColorBrush x:Key="McSubtleHover" Color="{StaticResource McSubtleHoverColor}" />
    <SolidColorBrush x:Key="McInput" Color="{StaticResource McInputColor}" />
    <SolidColorBrush x:Key="McAccent" Color="{StaticResource McAccentColor}" />
    <SolidColorBrush x:Key="McAccentHover" Color="{StaticResource McAccentHoverColor}" />
    <SolidColorBrush x:Key="McOnAccent" Color="{StaticResource McOnAccentColor}" />
    <SolidColorBrush x:Key="McAccentText" Color="{StaticResource McAccentColor}" />
    <SolidColorBrush x:Key="McAccentSoft" Color="{StaticResource McAccentSoftColor}" />
    <SolidColorBrush x:Key="McDisabledFill" Color="{StaticResource McDisabledFillColor}" />
    <SolidColorBrush x:Key="McDisabledText" Color="{StaticResource McDisabledTextColor}" />
    <SolidColorBrush x:Key="McTrack" Color="{StaticResource McTrackColor}" />
    <SolidColorBrush x:Key="McOk" Color="{StaticResource McOkColor}" />
    <SolidColorBrush x:Key="McErr" Color="{StaticResource McErrColor}" />
    <SolidColorBrush x:Key="McOkSoft" Color="{StaticResource McOkSoftColor}" />
    <SolidColorBrush x:Key="McErrSoft" Color="{StaticResource McErrSoftColor}" />
    <SolidColorBrush x:Key="McFlyout" Color="{StaticResource McFlyoutColor}" />
    <SolidColorBrush x:Key="McTransparent" Color="Transparent" />

    <!-- Radii -->
    <CornerRadius x:Key="McRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="McRadiusSetting">6</CornerRadius>
    <CornerRadius x:Key="McRadiusCard">8</CornerRadius>

    <!-- Extra brushes the light/dark palette (ThemeService) also changes -->
    <SolidColorBrush x:Key="McMenuBtn" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="McSmoke" Color="#4D000000" />
    <SolidColorBrush x:Key="McAudioTile" Color="#E6E8EE" />

    <!-- The app's accent is the brand blue (lighter in the dark theme), so every standard control
         (toggles, check boxes, sliders, focus) uses it. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#1F4FD6</Color>
            <Color x:Key="SystemAccentColorDark1">#1F4FD6</Color>
            <Color x:Key="SystemAccentColorDark2">#1A43B8</Color>
            <Color x:Key="SystemAccentColorDark3">#163A9C</Color>
            <Color x:Key="SystemAccentColorLight1">#4F77E6</Color>
            <Color x:Key="SystemAccentColorLight2">#7F9BEF</Color>
            <Color x:Key="SystemAccentColorLight3">#B0C2F7</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#7FA3FF</Color>
            <Color x:Key="SystemAccentColorDark1">#5C86F5</Color>
            <Color x:Key="SystemAccentColorDark2">#4A72E0</Color>
            <Color x:Key="SystemAccentColorDark3">#3A5FC8</Color>
            <Color x:Key="SystemAccentColorLight1">#9DB8F2</Color>
            <Color x:Key="SystemAccentColorLight2">#7FA3FF</Color>
            <Color x:Key="SystemAccentColorLight3">#C2D3FF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
