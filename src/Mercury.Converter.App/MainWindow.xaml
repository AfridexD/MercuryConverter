<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mercury.Converter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mercury.Converter.App.ViewModels"
    xmlns:core="using:Mercury.Converter.Core"
    xmlns:local="using:Mercury.Converter.App"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" Background="{StaticResource McBg}" SizeChanged="Root_SizeChanged" AllowDrop="True" DragOver="Files_DragOver" Drop="Files_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: 32 px, owl icon and name -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon32.png" Width="16" Height="16" />
                <TextBlock Text="Mercury Converter" FontSize="12" Foreground="{StaticResource McText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Command bar: 48 px -->
        <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="4" BorderBrush="{StaticResource McStroke}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="AddFilesButton" Grid.Column="0" Style="{StaticResource McSubtleButton}" Click="AddFiles_Click"
                    AutomationProperties.Name="Add files" ToolTipService.ToolTip="Add files (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource McAccentText}" />
                    <TextBlock Text="Add files" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource McSubtleButton}" Click="AddFolder_Click"
                    AutomationProperties.Name="Add folder" ToolTipService.ToolTip="Add folder (Ctrl+Shift+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="{StaticResource McAccentText}" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <Rectangle Grid.Column="2" Width="1" Height="20" Margin="6,0" Fill="{StaticResource McStroke}" />
            <Button Grid.Column="3" Style="{StaticResource McSubtleButton}" AutomationProperties.Name="View, preview size">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE80A;" FontSize="16" />
                    <TextBlock Text="View" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="ViewMenu" Opening="ViewMenu_Opening" />
                </Button.Flyout>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource McSubtleButton}" AutomationProperties.Name="Sort files">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                    <TextBlock x:Name="SortLabel" Text="Sort: Added" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" />
                </Button.Flyout>
            </Button>
            <Button x:Name="OptionsButton" Grid.Column="6" Style="{StaticResource McSubtleButton}" Visibility="Collapsed"
                    Click="Options_Click" AutomationProperties.Name="Options">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9E9;" FontSize="16" />
                    <TextBlock Text="Options" />
                </StackPanel>
            </Button>
            <Button Grid.Column="7" Style="{StaticResource McSubtleButton}" Click="Settings_Click"
                    AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Update notice. The question is asked once; the notice appears only if the user said yes. -->
        <StackPanel Grid.Row="2">
            <Border Padding="24,10" Background="{StaticResource McAccentSoft}" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowUpdateQuestion), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tell me when a new version is out?" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                        <TextBlock Text="Once a day Mercury asks GitHub if there is a newer version. Nothing else is sent. You can change this in Settings." Style="{StaticResource McCaptionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Yes, tell me" Style="{StaticResource McPrimaryButton}" Command="{x:Bind ViewModel.AnswerUpdateQuestionCommand}" CommandParameter="yes" />
                        <Button Content="No thanks" Style="{StaticResource McButton}" Command="{x:Bind ViewModel.AnswerUpdateQuestionCommand}" CommandParameter="no" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Padding="24,10" Background="{StaticResource McAccentSoft}" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowUpdateAvailable), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{StaticResource McAccentText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UpdateText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource McText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Download" Style="{StaticResource McPrimaryButton}" Command="{x:Bind ViewModel.OpenUpdatePageCommand}" />
                        <Button Content="Skip this version" Style="{StaticResource McButton}" Command="{x:Bind ViewModel.SkipUpdateCommand}" />
                        <Button Style="{StaticResource McSubtleButton}" Command="{x:Bind ViewModel.DismissUpdateCommand}" AutomationProperties.Name="Dismiss" Width="32" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Content: files and inspector -->
        <Grid x:Name="Content" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Files region -->
            <Grid x:Name="FilesRegion" Grid.Column="0" Background="{StaticResource McTransparent}">
                <!-- Empty state: dashed drop target -->
                <Grid Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsEmpty), Mode=OneWay}" Margin="24">
                    <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource McStrokeStrong}" StrokeThickness="2" StrokeDashArray="4 3" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource McAccentSoft}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="26" Foreground="{StaticResource McAccentText}" />
                        </Border>
                        <TextBlock Text="Drop files here" Style="{StaticResource McTitle16}" HorizontalAlignment="Center" />
                        <TextBlock Text="Photos, GIFs, videos and audio. Everything is converted on this computer. Nothing is uploaded."
                                   Style="{StaticResource McSecondaryText}" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="Add files" Style="{StaticResource McPrimaryButton}" Click="AddFiles_Click" />
                            <Button Content="Add folder" Style="{StaticResource McButton}" Click="AddFolder_Click" />
                        </StackPanel>
                        <TextBlock Text="JPEG, PNG, HEIC, RAW, MP4, MOV, MKV, MP3, WAV and 40 more" Style="{StaticResource McTertiaryText}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Queue -->
                <Grid Visibility="{x:Bind local:UiHelpers.Show(ViewModel.HasFiles), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Queue header -->
                    <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.QueueTitle, Mode=OneWay}" Style="{StaticResource McTitle16}" />
                            <TextBlock Text="{x:Bind ViewModel.QueueSub, Mode=OneWay}" Style="{StaticResource McSecondaryText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource McCompactButton}" Command="{x:Bind ViewModel.JumpToActiveCommand}"
                                Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsBusy), Mode=OneWay}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81D;" FontSize="14" />
                                <TextBlock Text="Jump to active" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar Grid.Row="1" Height="4" Margin="24,0,24,8" Minimum="0" Maximum="100" Foreground="{StaticResource McAccent}"
                                 Value="{x:Bind ViewModel.OverallPercent, Mode=OneWay}"
                                 Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsBusy), Mode=OneWay}"
                                 AutomationProperties.Name="Overall progress" />

                    <!-- Filter pills and banner -->
                    <StackPanel Grid.Row="2" Spacing="8" Padding="24,0,24,8">
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pills}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PillItem">
                                        <ToggleButton Style="{StaticResource McPill}" IsChecked="{x:Bind IsSelected}" Tag="{x:Bind Key}" Click="Pill_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{x:Bind GlyphBrush}" Visibility="{x:Bind GlyphVisibility}" />
                                                <TextBlock Text="{x:Bind Label}" />
                                                <TextBlock Text="{x:Bind CountText}" Opacity="0.7" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <Border CornerRadius="8" Padding="12,10" Background="{x:Bind ViewModel.BannerBackground, Mode=OneWay}"
                                Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowBanner), Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind ViewModel.BannerGlyph, Mode=OneWay}" FontSize="20"
                                          Foreground="{x:Bind ViewModel.BannerGlyphBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                    <TextBlock Text="{x:Bind ViewModel.BannerBody, Mode=OneWay}" Style="{StaticResource McSecondaryText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Show in folder" Style="{StaticResource McCompactButton}" Click="BannerShow_Click" />
                                    <Button Content="{x:Bind ViewModel.BannerRetryLabel, Mode=OneWay}" Style="{StaticResource McCompactButton}"
                                            Command="{x:Bind ViewModel.RetryProblemsCommand}"
                                            Visibility="{x:Bind local:UiHelpers.Show(ViewModel.BannerCanRetry), Mode=OneWay}" />
                                    <Button Style="{StaticResource McSubtleButton}" Command="{x:Bind ViewModel.DismissBannerCommand}"
                                            AutomationProperties.Name="Dismiss" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Card grid -->
                    <ScrollViewer Grid.Row="3" x:Name="CardScroller" VerticalScrollBarVisibility="Auto" Padding="24,4,24,16">
                        <ItemsRepeater x:Name="Cards" ItemsSource="{x:Bind ViewModel.VisibleFiles}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="176" MinItemHeight="236" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItem">
                                    <Grid Background="{StaticResource McCard}" CornerRadius="8" BorderBrush="{StaticResource McStroke}" BorderThickness="1"
                                          IsTabStop="False" Tapped="Card_Tapped" KeyDown="Card_KeyDown" RightTapped="Card_RightTapped"
                                          AutomationProperties.Name="{x:Bind AutomationText, Mode=OneWay}" Tag="{x:Bind}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="116" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Tile -->
                                        <Grid Grid.Row="0" CornerRadius="7,7,0,0" Background="{x:Bind TileBrush}">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                            <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="28" Foreground="{x:Bind TileIconBrush}"
                                                      Visibility="{x:Bind TileIconVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Visibility="{x:Bind DurationVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                    Padding="6,2" CornerRadius="4" Background="#99000000">
                                                <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Foreground="White" />
                                            </Border>
                                            <Border Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                    Width="20" Height="20" CornerRadius="10" Background="{StaticResource McAccent}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                            </Border>
                                            <Button Style="{StaticResource McSubtleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                    Width="28" Height="28" Padding="0" Background="#E6FFFFFF" Click="CardMenu_Click"
                                                    AutomationProperties.Name="{x:Bind MenuAutomationName}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                        </Grid>

                                        <!-- Text -->
                                        <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{StaticResource McText}"
                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="13" Foreground="{x:Bind StatusGlyphBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                           FontWeight="{x:Bind StatusWeight, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" Style="{StaticResource McCaptionText}"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <Button Content="{x:Bind RetryLabel, Mode=OneWay}" Style="{StaticResource McCompactButton}" Visibility="{x:Bind RetryVisibility, Mode=OneWay}"
                                                    Click="CardRetry_Click" Margin="0,4,0,0" />
                                            <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource McAccent}"
                                                         Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind BarIsMoving, Mode=OneWay}"
                                                         Visibility="{x:Bind BarVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind BarAutomationName}" />
                                        </StackPanel>

                                        <!-- Selected outline -->
                                        <Border Grid.RowSpan="2" CornerRadius="8" BorderBrush="{StaticResource McAccent}" BorderThickness="2" IsHitTestVisible="False"
                                                Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Narrow-mode scrim behind the options pane -->
            <Border x:Name="PaneScrim" Grid.ColumnSpan="2" Background="#33000000" Visibility="Collapsed" Tapped="Scrim_Tapped" />

            <!-- Inspector -->
            <Border x:Name="Inspector" Grid.Column="1" Background="{StaticResource McLayer}" BorderBrush="{StaticResource McStroke}" BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty -->
                    <StackPanel Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsEmpty), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="24">
                        <FontIcon Glyph="&#xE9E9;" FontSize="28" Foreground="{StaticResource McText3}" HorizontalAlignment="Center" />
                        <TextBlock Text="Options appear here" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource McText}" />
                        <TextBlock Text="They change to fit the files you add, so you only see what applies." Style="{StaticResource McSecondaryText}" TextAlignment="Center" MaxWidth="240" />
                    </StackPanel>

                    <ScrollViewer Visibility="{x:Bind local:UiHelpers.Show(ViewModel.HasFiles), Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="20,16,20,20" Spacing="20">
                            <!-- Header -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.InspectorTitle, Mode=OneWay}" Style="{StaticResource McTitle16}" />
                                    <TextBlock Text="{x:Bind ViewModel.InspectorSub, Mode=OneWay}" Style="{StaticResource McSecondaryText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear selection" Style="{StaticResource McLinkButton}" Command="{x:Bind ViewModel.ClearSelectionCommand}"
                                        Visibility="{x:Bind local:UiHelpers.Show(ViewModel.HasSelection), Mode=OneWay}" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Presets -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Presets" Style="{StaticResource McSectionLabel}" VerticalAlignment="Center" />
                                    <Button Content="Manage presets" Style="{StaticResource McLinkButton}" HorizontalAlignment="Right" Click="ManagePresets_Click" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chips}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="140" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipItem">
                                            <ToggleButton Style="{StaticResource McPill}" IsChecked="{x:Bind IsSelected}" Tag="{x:Bind}" Click="Chip_Click"
                                                          HorizontalAlignment="Stretch" ToolTipService.ToolTip="{x:Bind FullName}" AutomationProperties.Name="{x:Bind FullName}">
                                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Convert to -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Convert to" Style="{StaticResource McSectionLabel}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.KindRows}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KindRow">
                                            <Button Style="{StaticResource McButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="52"
                                                    Tag="{x:Bind}" Click="KindRow_Click" AutomationProperties.Name="{x:Bind AutomationName}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource McCaptionText}" />
                                                        <TextBlock Text="{x:Bind FormatName}" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                                    </StackPanel>
                                                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Quality -->
                            <StackPanel Spacing="8" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowQuality), Mode=OneWay}">
                                <Grid>
                                    <TextBlock Text="Quality" Style="{StaticResource McSectionLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.QualityLabel, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource McText}" />
                                </Grid>
                                <Slider Minimum="10" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="10" Value="{x:Bind ViewModel.Quality, Mode=TwoWay}"
                                        Foreground="{StaticResource McAccent}" AutomationProperties.Name="Quality" ThumbToolTipValueConverter="{x:Null}" />
                                <Border Background="{StaticResource McAccentSoft}" CornerRadius="6" Padding="12,10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                        <TextBlock Text="{x:Bind ViewModel.SavingText, Mode=OneWay}" Style="{StaticResource McCaptionText}" />
                                    </StackPanel>
                                </Border>
                                <CheckBox Content="Never make a file larger than the original" IsChecked="{x:Bind ViewModel.NeverLarger, Mode=TwoWay}" />
                            </StackPanel>
                            <Border Background="{StaticResource McAccentSoft}" CornerRadius="6" Padding="12,10"
                                    Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowLosslessNote), Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.LosslessNote, Mode=OneWay}" Style="{StaticResource McSecondaryText}" Foreground="{StaticResource McText}" />
                            </Border>

                            <!-- More options -->
                            <StackPanel Spacing="10" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.HasMoreOptions), Mode=OneWay}">
                                <Button Style="{StaticResource McSubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.ToggleMoreOptionsCommand}"
                                        AutomationProperties.Name="More options">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="More options" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                            <TextBlock Text="{x:Bind ViewModel.MoreSummary, Mode=OneWay}" Style="{StaticResource McCaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Glyph="{x:Bind ViewModel.MoreGlyph, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="14" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.MoreOptionsOpen), Mode=OneWay}">
                                    <StackPanel Spacing="6" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowSizeOption), Mode=OneWay}">
                                        <TextBlock Text="Size" Style="{StaticResource McSectionLabel}" />
                                        <ComboBox Style="{StaticResource McComboBox}" ItemsSource="{x:Bind ViewModel.SizeList}" DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.SelectedSize, Mode=TwoWay}" AutomationProperties.Name="Size" />
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowRotateOption), Mode=OneWay}">
                                        <TextBlock Text="Rotate and flip" Style="{StaticResource McSectionLabel}" />
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Content="Rotate left" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="RotateLeft_Click" />
                                            <Button Grid.Row="0" Grid.Column="1" Content="Rotate right" Style="{StaticResource McButton}" HorizontalAlignment="Stretch" Click="RotateRight_Click" />
                                            <ToggleButton Grid.Row="1" Grid.Column="0" Content="Flip sideways" HorizontalAlignment="Stretch" IsChecked="{x:Bind ViewModel.FlipHorizontal, Mode=TwoWay}" />
                                            <ToggleButton Grid.Row="1" Grid.Column="1" Content="Flip upside down" HorizontalAlignment="Stretch" IsChecked="{x:Bind ViewModel.FlipVertical, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.RotateNote, Mode=OneWay}" Style="{StaticResource McCaptionText}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowSpeedOption), Mode=OneWay}">
                                        <TextBlock Text="Video speed" Style="{StaticResource McSectionLabel}" />
                                        <ComboBox Style="{StaticResource McComboBox}" ItemsSource="{x:Bind ViewModel.SpeedChoices}" DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.SelectedSpeed, Mode=TwoWay}" AutomationProperties.Name="Video speed" />
                                        <TextBlock Text="Slower makes smaller files." Style="{StaticResource McCaptionText}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowChannelsOption), Mode=OneWay}">
                                        <TextBlock Text="Channels" Style="{StaticResource McSectionLabel}" />
                                        <ComboBox Style="{StaticResource McComboBox}" ItemsSource="{x:Bind ViewModel.ChannelChoices}" DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.SelectedChannels, Mode=TwoWay}" AutomationProperties.Name="Channels" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowStripOption), Mode=OneWay}">
                                        <CheckBox Content="Remove location and camera details" IsChecked="{x:Bind ViewModel.StripMetadata, Mode=TwoWay}" />
                                        <TextBlock Text="Photos, videos and songs lose their GPS position, camera model and date tags. Good before sharing online." Style="{StaticResource McCaptionText}" Margin="32,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Save to -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Save to" Style="{StaticResource McSectionLabel}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource McText2}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolderText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{StaticResource McText}" ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolderText, Mode=OneWay}" />
                                    <Button Grid.Column="2" Content="Change" Style="{StaticResource McCompactButton}" Click="ChooseFolder_Click" />
                                </Grid>
                                <Button Content="Use the original folder" Style="{StaticResource McLinkButton}" Click="UseOriginalFolder_Click"
                                        Visibility="{x:Bind local:UiHelpers.Show(ViewModel.OutputFolderIsCustom), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.NamingText, Mode=OneWay}" Style="{StaticResource McCaptionText}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings page, shown over the content -->
        <local:SettingsView x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="4" ViewModel="{x:Bind ViewModel}"
                            Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsSettingsOpen), Mode=OneWay}" />

        <!-- Action bar: 64 px -->
        <Grid Grid.Row="4" Height="64" Padding="24,0" ColumnSpacing="8" Background="{StaticResource McLayer}" BorderBrush="{StaticResource McStroke}" BorderThickness="0,1,0,0"
              Visibility="{x:Bind local:UiHelpers.Hide(ViewModel.IsSettingsOpen), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource McSecondaryText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource McButton}" Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowCancel), Mode=OneWay}" />
            <Button Grid.Column="2" Content="Clear list" Style="{StaticResource McButton}" Command="{x:Bind ViewModel.ClearListCommand}"
                    Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowClearList), Mode=OneWay}" />
            <Button x:Name="ConvertButton" Grid.Column="3" Content="{x:Bind ViewModel.ConvertLabel, Mode=OneWay}" Style="{StaticResource McPrimaryButton}"
                    Command="{x:Bind ViewModel.ConvertCommand}" MinWidth="160" />
        </Grid>
    </Grid>
</Window>
