<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mercury.Converter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mercury.Converter.App"
    xmlns:vm="using:Mercury.Converter.App.ViewModels"
    xmlns:core="using:Mercury.Converter.Core">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- A rounded panel, like the property cards in Clipchamp and the info pane in Photos. -->
            <Style x:Key="PanelCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock x:Uid="AppTitle" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Margin="20,4,20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource AccentButtonStyle}" Click="AddFiles_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="AddFilesText" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Click="AddFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                    <TextBlock x:Uid="AddFolderText" />
                </StackPanel>
            </Button>

            <DropDownButton Grid.Column="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                    <TextBlock x:Uid="ViewText" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <RadioMenuFlyoutItem x:Name="ThumbOff" x:Uid="ThumbOffItem" GroupName="Thumbs" Tag="Off" Click="Thumbnails_Click" />
                        <RadioMenuFlyoutItem x:Name="ThumbSmall" x:Uid="ThumbSmallItem" GroupName="Thumbs" Tag="Small" Click="Thumbnails_Click" />
                        <RadioMenuFlyoutItem x:Name="ThumbMedium" x:Uid="ThumbMediumItem" GroupName="Thumbs" Tag="Medium" Click="Thumbnails_Click" />
                        <RadioMenuFlyoutItem x:Name="ThumbLarge" x:Uid="ThumbLargeItem" GroupName="Thumbs" Tag="Large" Click="Thumbnails_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <ToggleSwitch x:Name="ShellToggle"
                          x:Uid="ShellToggle"
                          Grid.Column="4"
                          Toggled="ShellToggle_Toggled" />
        </Grid>

        <!-- Canvas and properties panel -->
        <Grid Grid.Row="2" Margin="20,0,20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Canvas -->
            <Border x:Name="DropZone"
                    Style="{StaticResource PanelCard}"
                    Padding="0"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid>
                    <!-- Shown until a file is added -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind local:UiHelpers.Hide(ViewModel.HasFiles), Mode=OneWay}">
                        <FontIcon Glyph="&#xE896;" FontSize="48" Opacity="0.45" />
                        <TextBlock x:Uid="DropHint"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7" />
                        <TextBlock x:Uid="AppSubtitle"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   TextAlignment="Center"
                                   Opacity="0.55" />
                    </StackPanel>

                    <GridView ItemsSource="{x:Bind ViewModel.Files}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Padding="14"
                              Visibility="{x:Bind local:UiHelpers.Show(ViewModel.HasFiles), Mode=OneWay}">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <Grid Width="{x:Bind Options.CardWidth, Mode=OneWay}"
                                      CornerRadius="8"
                                      BorderThickness="1"
                                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Preview -->
                                    <Grid Height="{x:Bind Options.ThumbnailHeight, Mode=OneWay}"
                                          Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
                                          Visibility="{x:Bind local:UiHelpers.Show(Options.ShowThumbnails), Mode=OneWay}">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                        <FontIcon Glyph="{x:Bind KindGlyph}"
                                                  FontSize="32"
                                                  Opacity="0.45"
                                                  Visibility="{x:Bind local:UiHelpers.Show(ShowGlyph), Mode=OneWay}" />
                                    </Grid>

                                    <!-- Name and status -->
                                    <StackPanel Grid.Row="1" Padding="12,10,12,2" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.8"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- Result, such as sizes before and after, or the reason a file failed. The line is always reserved so cards stay the same height. -->
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.6"
                                                   MinHeight="16"
                                                   MaxLines="1"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Waiting animation, then a real progress bar in the same place -->
                                    <ProgressBar Grid.Row="2"
                                                 Margin="12,6,12,12"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{x:Bind Progress, Mode=OneWay}"
                                                 IsIndeterminate="{x:Bind IsWaiting, Mode=OneWay}"
                                                 ShowError="{x:Bind IsFailed, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>

            <!-- Properties panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,12,12">

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="PresetsHeader" Style="{StaticResource PanelTitle}" />
                            <ComboBox x:Name="PresetBox"
                                      x:Uid="PresetBox"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.Presets}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="PresetBox_SelectionChanged" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="PresetNameBox" Text="{x:Bind ViewModel.PresetName, Mode=TwoWay}" />
                                <Button Grid.Column="1" x:Uid="SavePresetButton" Command="{x:Bind ViewModel.SavePresetCommand}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="ImportPresetsButton" Click="ImportPresets_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" x:Uid="ExportPresetsButton" Click="ExportPresets_Click" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="ConvertToHeader" Style="{StaticResource PanelTitle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.AvailableTargets}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <CheckBox x:Uid="LosslessCheck"
                                      IsChecked="{x:Bind ViewModel.LosslessJpeg, Mode=TwoWay}"
                                      Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowLosslessOption), Mode=OneWay}" />

                            <TextBlock x:Uid="QualityHeader" Style="{StaticResource PanelTitle}" Margin="0,8,0,0" />
                            <Slider Minimum="1" Maximum="100" StepFrequency="1"
                                    Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.QualityLabel, Mode=OneWay}" Opacity="0.7" />
                            <CheckBox x:Uid="KeepSmallerCheck"
                                      IsChecked="{x:Bind ViewModel.KeepSmallerThanOriginal, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SizeHeader" Style="{StaticResource PanelTitle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.SizeOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSize, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <TextBlock x:Uid="RotateHeader" Style="{StaticResource PanelTitle}" Margin="0,8,0,0" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.RotationOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedRotation, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Uid="FlipHorizontalCheck" IsChecked="{x:Bind ViewModel.FlipHorizontal, Mode=TwoWay}" />
                                <CheckBox x:Uid="FlipVerticalCheck" IsChecked="{x:Bind ViewModel.FlipVertical, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}"
                            Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowVideoOptions), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="AdvancedHeader" Style="{StaticResource PanelTitle}" />
                            <TextBox x:Uid="AdvancedBox" Text="{x:Bind ViewModel.ExtraFfmpegArguments, Mode=TwoWay}" />
                            <TextBlock x:Uid="AdvancedHint"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SpeedHeader" Style="{StaticResource PanelTitle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.ModeOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <TextBlock Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                            <StackPanel Spacing="4"
                                        Margin="0,6,0,0"
                                        Visibility="{x:Bind local:UiHelpers.Show(ViewModel.ShowGraphicsOption), Mode=OneWay}">
                                <CheckBox x:Uid="GpuCheck"
                                          IsChecked="{x:Bind ViewModel.UseGraphicsCardEncoder, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.GraphicsEncoderAvailable, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.GraphicsEncoderText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.65"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SaveToHeader" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.OutputFolderText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="ChooseFolderButton" Click="ChooseFolder_Click" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" x:Uid="OriginalFolderButton" Click="UseOriginalFolder_Click" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Uid="FooterNote"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Action bar -->
        <Grid Grid.Row="3" Margin="20,14,20,18" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="ConvertButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConvertCommand}"
                    MinWidth="150" />
            <Button Grid.Column="1" x:Uid="CancelButton" Command="{x:Bind ViewModel.CancelCommand}" MinWidth="100" />
            <Button Grid.Column="2" x:Uid="ClearButton" Command="{x:Bind ViewModel.ClearCommand}" MinWidth="100" />
            <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                <ProgressBar Minimum="0" Maximum="1"
                             Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}"
                             Visibility="{x:Bind local:UiHelpers.Show(ViewModel.IsBusy), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
