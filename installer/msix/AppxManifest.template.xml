<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the Microsoft Store version of Mercury Converter.
  scripts\build-msix.ps1 fills in the {{values}} and the right-click menu, then packs this folder into an .msix.
  The Identity values must be the ones Partner Center shows under "Product identity" for the reserved name.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop4 desktop5 com rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{PackageDisplayName}}</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\Package\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MercuryConverter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Mercury Converter"
        Description="Convert photos, GIFs, video and audio on your own PC. Free, private, nothing is uploaded."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Package\Square150x150Logo.png"
        Square44x44Logo="Assets\Package\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Package\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
{{MenuExtensions}}      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Mercury is a normal Windows program that starts the converter programs it carries and saves files where you choose. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
